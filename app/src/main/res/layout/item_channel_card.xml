<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="164dp"
    android:layout_height="92dp"
    android:layout_marginEnd="12dp"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- 卡片主体（聚焦态背景由 BrowseAdapter 切换） -->
    <LinearLayout
        android:id="@+id/card_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/card_normal_bg"
        android:orientation="vertical"
        android:paddingStart="13dp"
        android:paddingTop="9dp"
        android:paddingEnd="13dp"
        android:paddingBottom="9dp">

        <TextView
            android:id="@+id/num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/dim"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- 台标：居中大图（Apple TV 频道卡风格） -->
        <ImageView
            android:id="@+id/logo"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="1dp"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <!-- 无台标时兜底显示频道名 -->
        <TextView
            android:id="@+id/logo_name_fallback"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="1dp"
            android:gravity="center"
            android:ellipsize="end"
            android:lines="1"
            android:textColor="@color/text"
            android:textSize="17sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lines="1"
            android:textColor="@color/text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:lines="1"
            android:textColor="@color/dim"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- 在播标记：Apple TV 直播红点（无文字） -->
    <View
        android:id="@+id/live_badge"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/live_dot"
        android:visibility="gone" />
</FrameLayout>
