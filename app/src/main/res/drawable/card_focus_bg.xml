<?xml version="1.0" encoding="utf-8"?>
<!-- 聚焦卡片：白卡 + 军绿实描边 + 外层柔光晕，大屏远距离一眼锁定焦点（v1.11 强化） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外层：半透明军绿宽描边，形成发光轮廓 -->
    <item>
        <shape>
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="15dp" />
            <stroke
                android:width="10dp"
                android:color="#66A9C077" />
        </shape>
    </item>
    <!-- 内层：清晰实色描边 -->
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape>
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="11dp" />
            <stroke
                android:width="4dp"
                android:color="#8A9B62" />
        </shape>
    </item>
</layer-list>
