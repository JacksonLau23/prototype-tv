<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 频道卡片：常态深灰 / 聚焦 Apple 白卡（tvOS 焦点材质） -->
    <item android:state_focused="true">
        <shape>
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="12dp" />
            <!-- 军绿粗描边：远距离也一眼锁定焦点卡片 -->
            <stroke
                android:width="5dp"
                android:color="#8A9B62" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#F028282D" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="#66484850" />
        </shape>
    </item>
</selector>
